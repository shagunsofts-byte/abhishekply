rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true; 
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /quoteRequests/{requestId} {
      // Anyone (including guests) can submit a quote request from the site —
      // this is the "Add to Quote" checkout flow, equivalent to a contact form.
      allow create: if request.resource.data.keys().hasAll(['items', 'status', 'createdAt'])
                    && request.resource.data.status == 'new';
      // Only the admin can view or manage submitted quote requests.
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      // Users may only ever create themselves as a non-admin account.
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'customer';
      // Self-updates may never touch the role field; only an admin can change roles.
      allow update: if isAdmin()
                    || (isAuthenticated() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
  }
}
